@inproceedings{26-VRST-kim,
 abstract = {Obstacle negotiation means stepping over, crossing, or passing through an obstacle while regulating gait and foot placement. It differs from detecting one or steering around it, and is hard to study once vision is unavailable. We present a walkable VR testbed for this task. Participants traverse a bounded lane between two tactile mats and negotiate procedurally sized steps, trenches, and gaps with the display fully occluded, while head, waist, and foot tracking drive a full-body digital twin. Sensory substitution conveys the obstacle as sound through the foundational vOICe mapping. Sessions with thirteen sighted participants indicate that audibility and negotiation difficulty resist separation, stalling the adaptive staircase on two of three obstacle classes.},
 address = {New York, NY, USA},
 author = {Kim, Myung Jin (MJ) and Kim, Mooseop and Yi, HyeonBeom and Jeong, Chi Yoon},
 booktitle = {Proceedings of the 32nd ACM Symposium on Virtual Reality Software and Technology},
 doi = {10.1145/3822517.3849923},
 isbn = {9798400728112},
 keywords = {Virtual Reality, Assistive Technology, Sensory Substitution, Obstacle Negotiation, Walkable VR},
 location = {Sendai, Japan},
 numpages = {3},
 pages = {1--3},
 publisher = {Association for Computing Machinery},
 series = {VRST '26},
 title = {Finding the Way Through: A Walkable VR Testbed for Nonvisual Obstacle Negotiation},
 url = {https://doi.org/10.1145/3822517.3849923},
 year = {2026}
}
