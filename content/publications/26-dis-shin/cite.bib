@inproceedings{26-DIS-shin,
 abstract = {Music education for Deaf and hard-of-hearing (DHH) learners remains challenging because access to auditory cues is constrained and instruction is often shaped by hearing-centered pedagogical and communication structures. Prior work has explored haptics for music, yet offers limited situated knowledge of how haptic cues should be designed and negotiated within authentic instruction. We address this gap through a co-design method centered on reconfigurable haptic prototyping. Using modular tactors that can be rapidly repositioned and retuned, we conducted four co-design workshops with educator-learner dyads in South Korea. The workshops involved hands-on trials, bodystorming, and mock teaching enactment to explore music-to-haptic cues within realistic instructional interaction. We show that haptics can support pedagogical fit, make musical concepts tangible as formative in-the-moment support, and function as a shared reference in instruction. We contribute a co-design method, empirical insights into haptics in music instruction, and design implications for DHH music education.},
 address = {New York, NY, USA},
 author = {Shin, Sungyong and Yi, HyeonBeom and Choi, Dasom and Lee, Yoonji and Jeong, Chi Yoon and Lee, Chang Hee and Lee, Woohun},
 booktitle = {Proceedings of the 2026 Designing Interactive Systems Conference},
 doi = {10.1145/3800645.3813055},
 isbn = {9798400725630},
 keywords = {Deaf and Hard-of-Hearing (DHH), music education, haptic, co-design, accessibility},
 location = {Singapore, Singapore},
 numpages = {15},
 pages = {1760-1774},
 publisher = {Association for Computing Machinery},
 series = {DIS '26},
 title = {Co-designing Haptics for Deaf and Hard-of-Hearing Music Education with a Reconfigurable Prototyping System},
 url = {https://doi.org/10.1145/3800645.3813055},
 year = {2026}
}
